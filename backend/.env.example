# Key used to sign login tokens. Use a long random string.
SECRET_KEY=

# Database location. Leave empty to use the local SQLite file.
DATABASE_URL=

# First manager account. The server creates it automatically on start.
# If either value is missing, the server refuses to start.
MANAGER_NAME=
MANAGER_PASSWORD=

# Password managers type to remove a number from the Do-not-track list.
# Leave empty to turn removal off (the server refuses with a clear message).
DO_NOT_TRACK_REMOVE_PASSWORD=
